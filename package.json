{
  "name": "websql-configurable",
  "version": "4.0.0",
  "description": "WebSQL Database API, implemented for Node using better-sqlite3",
  "repository": {
    "type": "git",
    "url": "git://github.com/brettz9/node-websql.git"
  },
  "bugs": {
    "url": "https://github.com/brettz9/node-websql/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./custom/index.js": {
      "types": "./dist/custom/index.d.ts",
      "import": "./custom/index.js"
    },
    "./lib/websql/WebSQLDatabase.js": {
      "types": "./dist/lib/websql/WebSQLDatabase.d.ts",
      "import": "./lib/websql/WebSQLDatabase.js"
    },
    "./lib/websql/WebSQLTransaction.js": {
      "types": "./dist/lib/websql/WebSQLTransaction.d.ts",
      "import": "./lib/websql/WebSQLTransaction.js"
    },
    "./lib/websql/WebSQLResultSet.js": {
      "types": "./dist/lib/websql/WebSQLResultSet.d.ts",
      "import": "./lib/websql/WebSQLResultSet.js"
    },
    "./lib/sqlite/SQLiteDatabase.js": {
      "types": "./dist/lib/sqlite/SQLiteDatabase.d.ts",
      "import": "./lib/sqlite/SQLiteDatabase.js"
    }
  },
  "types": "./index.d.ts",
  "browser": {
    "lib/index.js": "lib/browser.js",
    "crypto": false,
    "fs": false,
    "levelup": false,
    "leveldown": false,
    "level": false,
    "rimraf": false,
    "mkdirp": false,
    "better-sqlite3": false
  },
  "keywords": [
    "websql",
    "sql",
    "opendatabase",
    "sqlite",
    "storage",
    "better-sqlite3",
    "database"
  ],
  "scripts": {
    "prepublishOnly": "npm run build && npm run attw",
    "tsc": "tsc",
    "tsc:ts7": "npx -y -p typescript@^7 -c \"tsc\"",
    "lint": "eslint .",
    "attw": "attw --pack . --profile node16 --profile esm-only",
    "build": "tsc -p tsconfig-prod.json && cp lib/types.d.ts lib/ambient.d.ts dist/lib/",
    "mocha": "mocha test/test.js",
    "test-debug": "mocha --debug-brk test/test.js",
    "test": "c8 npm run mocha"
  },
  "c8": {
    "check-coverage": true,
    "lines": 100,
    "functions": 100,
    "statements": 100,
    "branches": 100
  },
  "engines": {
    "node": "^22.18.0 || >= 24.11.0"
  },
  "author": "Brett Zamir",
  "license": "Apache-2.0",
  "dependencies": {
    "argsarray": "^0.0.1",
    "better-sqlite3": "^13.0.3",
    "immediate": "^3.3.0",
    "noop-fn": "^1.0.0",
    "tiny-queue": "^0.2.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "assert": "2.1.0",
    "c8": "^12.0.0",
    "chai": "6.2.2",
    "chai-as-promised": "8.0.2",
    "debug": "^4.4.3",
    "double-ended-queue": "2.1.0-0",
    "eslint": "^10.11.0",
    "eslint-config-ash-nazg": "^43.2.2",
    "js-extend": "1.0.1",
    "level-write-stream": "1.0.0",
    "levelup": "5.1.1",
    "lie": "3.3.0",
    "mkdirp": "^3.0.1",
    "mocha": "^12.0.2",
    "npm-run-all": "^4.1.5",
    "pouchdb-collate": "9.0.0",
    "pouchdb-collections": "^8.0.1",
    "request": "^2.88.2",
    "rimraf": "^6.1.3",
    "scope-eval": "1.0.0",
    "spark-md5": "3.0.2",
    "sublevel-pouchdb": "9.0.0",
    "typescript": "^6.0.3",
    "vuvuzela": "1.0.3"
  },
  "files": [
    "dist",
    "lib",
    "custom"
  ],
  "allowScripts": {
    "fsevents@2.3.2": true,
    "better-sqlite3@13.0.3": true,
    "unrs-resolver@1.12.2": true
  }
}
