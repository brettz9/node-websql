{
  "compilerOptions": {
    "lib": ["esnext"],
    "moduleResolution": "nodenext",
    "module": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "es6",
    "outDir": "dist"
  },
  "include": ["lib/**/*.js", "lib/**/*.d.ts", "custom/**/*.js", "index.d.ts"],
  "exclude": ["node_modules"]
}
