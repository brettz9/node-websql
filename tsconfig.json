{
  "compilerOptions": {
    "lib": ["es2023"],
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "es6",
    "outDir": "dist"
  },
  "include": ["test/**/*.js", "lib/**/*.js", "custom/**/*.js"],
  "exclude": ["node_modules"]
}
