{
  "compilerOptions": {
    "lib": ["esnext"],
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "target": "es2024",
    "outDir": "dist",
    "types": ["node", "websql"]
  },
  // "test/**/*.js",
  "include": ["lib/**/*.js", "lib/**/*.d.ts", "custom/**/*.js"],
  "exclude": ["node_modules"]
}
